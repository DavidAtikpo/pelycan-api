# Copier vers .env et ajuster (ne pas committer .env)
# Optionnel si Java 21 n est pas detecte automatiquement:
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.8-hotspot
# MAVEN_HOME=C:\Program Files\Apache\Maven\apache-maven-3.9.9
PORT=4000
# jdbc:... ou postgresql://user:pass@host:5432/db (Spring -> PELYCAN_JDBC_URL)
DATABASE_URL=jdbc:postgresql://localhost:5432/pelycan
DATABASE_USERNAME=pelycan
DATABASE_PASSWORD=pelycan
JWT_SECRET=dev-only-change-me-use-secrets-manager-in-aws-32chars
REDIS_HOST=localhost
REDIS_PORT=6379
# sans Redis/Docker en local : simple (cache memoire, health UP)
# PELYCAN_CACHE_TYPE=simple
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optionnel — push FCM admin (fichier compte de service Firebase)
# FIREBASE_CREDENTIALS_PATH=C:/chemin/vers/firebase-adminsdk.json
# FIREBASE_ADMIN_NOTIFY=false
# Optionnel — SMS Twilio pour alerter les contacts d'urgence
# SMS_ENABLED=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+33XXXXXXXXX
# SMS_DEFAULT_COUNTRY_CODE=33
# Google Cloud Speech-to-Text (dictée chat mobile)
GOOGLE_SPEECH_API_KEY=
GOOGLE_SPEECH_LANGUAGE=fr-FR
